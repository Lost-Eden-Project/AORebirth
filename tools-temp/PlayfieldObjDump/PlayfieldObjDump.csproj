<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AORebirthRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</AORebirthRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AORebirthRepositoryRoot)/AORebirth/Libraries/Source/AORebirth.World.Collision/AORebirth.World.Collision.csproj" />
    <ProjectReference Include="$(AORebirthRepositoryRoot)/AORebirth/Libraries/Source/AORebirth.World.Pathfinding/AORebirth.World.Pathfinding.csproj" />
  </ItemGroup>
</Project>
