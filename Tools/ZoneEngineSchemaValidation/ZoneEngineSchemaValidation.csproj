<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MissionChestConnectedTests)' == 'true'">
    <DefineConstants>$(DefineConstants);MISSION_CHEST_CONNECTED_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MissionChestConnectedTests)' == 'true'">
    <!-- These older acceptance bodies use removed product APIs; chest mode uses the current quest path. -->
    <Compile Remove="ConnectedMissionSeed.cs;CharacterPersistenceGameplaySmoke.cs;ConnectedHandoffAcceptance.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../SharedBuild/Tests/DeterministicLoginKeyEncoder.cs" Link="Shared/DeterministicLoginKeyEncoder.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Core/Encryption/BigInteger.cs" Link="Shared/BigInteger.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Core/Encryption/PasswordHash.cs" Link="Shared/PasswordHash.cs" />
    <ProjectReference Include="../DatabaseMigrationTool/DatabaseMigrationTool.csproj" />
    <ProjectReference Include="../../AORebirth/Server/ZoneEngine_New/ZoneEngine_New.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(LoginCharacterCreationFocusedTests)' == 'true'">
    <DefineConstants>$(DefineConstants);LOGIN_CHARACTER_CREATION_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LoginCharacterCreationFocusedTests)' == 'true'">
    <ProjectReference Remove="../../AORebirth/Server/ZoneEngine_New/ZoneEngine_New.csproj" />
    <ProjectReference Include="../../WindowsBuildNet10/Projects/LoginEngine.WinNet10.csproj" />
    <Compile Remove="@(Compile)" />
    <Compile Include="Program.cs" />
    <Compile Include="CharacterCreationSmoke.cs" />
    <Compile Include="CharacterPersistenceFaultSmoke.cs" />
    <None Include="../../AORebirth/GameData/NewCharacter.json" Link="GameData/NewCharacter.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(LoginCharacterCreationFocusedTests)' != 'true'">
    <Compile Remove="CharacterCreationSmoke.cs" />
  </ItemGroup>
</Project>
