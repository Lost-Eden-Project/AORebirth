<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- The same isolated host the mission DAO validation uses: real MySQL provider, no application configuration. -->
    <DefineConstants>$(DefineConstants);MISSION_DAO_ISOLATED_TESTS;AOREBIRTH_WIN_NET10</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../MissionDaoValidation/IsolatedHost.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AOtomation/AOtomation.Messaging/src/SmokeLounge.AOtomation.Messaging/GameData/IdentityType.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AOtomation/AOtomation.Messaging/src/SmokeLounge.AOtomation.Messaging/GameData/CharacterStat.cs" />
    <!-- Compile the actual persistence sources, never a second DAO implementation. -->
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Interfaces/Persistence/Accounts/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Interfaces/Persistence/Characters/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Characters/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Accounts/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Interfaces/Persistence/Missions/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Missions/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Domain/Quests/**/*.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/DatabaseDaoFactory.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Dao/NewCharacterStartAreaSelectionDao.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Database/Dao/CharacterOnlineOwnershipGuard.cs" />
    <Compile Include="../../AORebirth/Libraries/Source/AORebirth.Enums/StatIds.cs" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>
</Project>
