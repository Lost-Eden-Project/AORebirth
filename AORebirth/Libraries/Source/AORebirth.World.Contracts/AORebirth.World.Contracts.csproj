<Project Sdk="Microsoft.NET.Sdk">
  <!-- World service contracts (gRPC) and the client used by ZoneEngine_New, LoginEngine and ChatEngine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <RootNamespace>AORebirth.World.Contracts</RootNamespace>
    <AssemblyName>AORebirth.World.Contracts</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/world.proto" GrpcServices="Both" />
  </ItemGroup>
</Project>
