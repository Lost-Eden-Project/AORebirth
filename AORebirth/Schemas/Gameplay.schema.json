{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Gameplay.schema.json",
  "title": "Gameplay settings (Config/Gameplay.json).",
  "description": "Generated by Tools/GameDataSchemas from GameplaySettings; do not edit by hand.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "stuckCooldownSeconds": {
      "type": "integer"
    },
    "stuckLocation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "playfield": {
          "type": "integer"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "isValid": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qualityVariancePercent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Corpse drops (item table and equipment spawns) roll their QL within this percent either side of the NPC's level or the spawn's QL. An item table row with its own levelMod (above 0) uses that instead."
        }
      }
    },
    "shops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferDatabaseStock": {
          "type": "boolean"
        }
      }
    },
    "requireAmmo": {
      "type": "boolean"
    },
    "zoneInGraceSeconds": {
      "type": "number",
      "minimum": 0
    },
    "xp": {
      "type": "object",
      "properties": {
        "sideBonusPercent": {
          "type": "number"
        },
        "killPercentPerLevelDifference": {
          "type": "number"
        },
        "alienMinimumXp": {
          "type": "integer",
          "minimum": 0
        },
        "noKillXpNpcFamilies": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "deathXpLossGraceLevel": {
          "type": "integer"
        },
        "defaultXpPoolRecoveryPercent": {
          "type": "integer"
        },
        "tradeskillGrantsXp": {
          "type": "boolean"
        },
        "tradeskillXpPerQl": {
          "type": "integer"
        },
        "teamMemberPercent": {
          "description": "Percent of the team kill share each nearby member gets, by member count (entry 0 = 1 member; larger teams use the last entry). NOT correct: a stand-in until live's team XP rule is known.",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "caps": {
          "type": "object",
          "properties": {
            "killXp": {
              "type": "number"
            },
            "quest": {
              "type": "number"
            },
            "research": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "wander": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "number"
        },
        "minPauseSeconds": {
          "type": "number"
        },
        "maxPauseSeconds": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "pvp": {
      "type": "object",
      "properties": {
        "damagePercent": {
          "type": "number"
        },
        "critChancePercent": {
          "type": "number"
        },
        "maxHitPercent": {
          "type": "number"
        },
        "attackerFlagNano": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "proximityAggro": {
      "type": "object",
      "description": "Unprovoked (proximity) aggro limits.",
      "properties": {
        "maxWalkFactor": {
          "type": "number",
          "minimum": 0,
          "description": "An NPC only aggroes a player it can walk to within this many times its aggro range: one under a bridge stays put. 0 turns the check off."
        }
      },
      "additionalProperties": false
    },
    "socialAggro": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultRadius": {
          "type": "number"
        },
        "maxRadius": {
          "type": "number"
        },
        "searchRadius": {
          "type": "number"
        },
        "sameClanOnly": {
          "type": "boolean",
          "description": "Helpers must share the attacked NPC's Clan stat (its kind of creature) as well as its Side."
        },
        "requireLineOfSight": {
          "type": "boolean"
        },
        "maxHelpers": {
          "type": "integer"
        },
        "chain": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "pets": {
      "type": "object",
      "properties": {
        "ownerThreatSharePercent": {
          "type": "number"
        },
        "ownerAlwaysOnHateList": {
          "type": "boolean"
        },
        "ownerSharesPetEngageRange": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "worldClock": {
      "type": "object",
      "properties": {
        "epochUtc": {
          "type": "string"
        },
        "dayAtEpoch": {
          "type": "integer"
        },
        "timeOfDayAtEpochSeconds": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "npcNanos": {
      "type": "object",
      "properties": {
        "minCastIntervalSeconds": {
          "type": "number"
        },
        "maxCastIntervalSeconds": {
          "type": "number"
        },
        "minBuffIntervalSeconds": {
          "type": "number"
        },
        "maxBuffIntervalSeconds": {
          "type": "number"
        },
        "idleCheckSeconds": {
          "type": "number"
        },
        "buffInCombat": {
          "type": "boolean"
        },
        "supportRange": {
          "type": "number"
        },
        "healBelowPercent": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "properties": {
        "overflowCapacity": {
          "type": "integer"
        },
        "maxCredits": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "halloween": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ipResetPoints": {
      "type": "object",
      "properties": {
        "titleLevels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "alienLevels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
