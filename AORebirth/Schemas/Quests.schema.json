{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Quests.schema.json",
  "title": "Quests: Quests.json quest templates, a list keyed by Hash.",
  "description": "Generated by Tools/GameDataSchemas from QuestTemplate; do not edit by hand.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Hash": {
        "type": "string",
        "pattern": "^[0-9A-Z_]{4}$"
      },
      "Name": {
        "type": "string"
      },
      "Title": {
        "type": [
          "string",
          "null"
        ]
      },
      "Description": {
        "type": [
          "string",
          "null"
        ]
      },
      "IconId": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "QasInstance": {
        "type": "integer",
        "minimum": 0
      },
      "Scope": {
        "type": "string",
        "enum": [
          "Solo",
          "Team"
        ]
      },
      "Action": {
        "type": "string",
        "enum": [
          "KillOne",
          "KillMultiple",
          "TargetNpc",
          "TalkTo",
          "FindItem",
          "FindItem2",
          "ReturnToQuestGiver",
          "UseItemOnCharacter",
          "UseItemOnCharacterDev",
          "UseItemOnItem",
          "Assemble",
          "CreateItem",
          "BringItemHere",
          "EscortItem",
          "Escort"
        ]
      },
      "Summary": {
        "type": "string"
      },
      "Objective": {
        "type": "object",
        "properties": {
          "Count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "Npc": {
            "type": [
              "string",
              "null"
            ]
          },
          "SpecItem": {
            "type": [
              "string",
              "null"
            ]
          },
          "WorldItem": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Flags": {
        "type": "string",
        "pattern": "^(None|(NoXp|NoCash|Failed|NoDelete)(, (NoXp|NoCash|Failed|NoDelete))*)$",
        "description": "Comma list of NoXp, NoCash, Failed, NoDelete, or \u0022None\u0022."
      },
      "MissionBit": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 639
      },
      "NextStep": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9A-Z_]{4}$"
      },
      "Reward": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "Hash": {
            "type": "string"
          },
          "Credits": {
            "type": "integer"
          },
          "Xp": {
            "type": "integer"
          },
          "Records": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "Id": {
                    "type": "integer"
                  },
                  "HighId": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "Name": {
                    "type": "string"
                  },
                  "Quality": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "additionalProperties": false
      },
      "Waypoints": {
        "description": "Dumped waypoints; not read by the server.",
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "object",
          "properties": {
            "Playfield": {
              "type": "integer"
            },
            "X": {
              "type": "integer"
            },
            "Y": {
              "type": "integer"
            },
            "Z": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
