{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Quests.schema.json",
  "title": "Quests: Quests.json quest templates, a list keyed by Hash.",
  "description": "Generated by Tools/GameDataSchemas from QuestTemplate; do not edit by hand.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "Hash": {
        "type": "string",
        "pattern": "^[0-9A-Z_]{4}$"
      },
      "Name": {
        "type": "string"
      },
      "Title": {
        "type": [
          "string",
          "null"
        ]
      },
      "Description": {
        "type": [
          "string",
          "null"
        ]
      },
      "IconId": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "QasInstance": {
        "type": "integer",
        "minimum": 0
      },
      "Scope": {
        "type": "string",
        "enum": [
          "Solo",
          "Team"
        ]
      },
      "Action": {
        "type": "string",
        "enum": [
          "KillOne",
          "KillMultiple",
          "TargetNpc",
          "TalkTo",
          "FindItem",
          "FindItem2",
          "ReturnToQuestGiver",
          "UseItemOnCharacter",
          "UseItemOnCharacterDev",
          "UseItemOnItem",
          "Assemble",
          "Equip",
          "CreateItem",
          "BringItemHere",
          "EscortItem",
          "Escort"
        ]
      },
      "Summary": {
        "type": "string"
      },
      "Objective": {
        "type": "object",
        "properties": {
          "Count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "Npc": {
            "type": [
              "string",
              "null"
            ]
          },
          "FindChance": {
            "type": [
              "integer",
              "null"
            ]
          },
          "SpecItem": {
            "type": [
              "string",
              "null"
            ]
          },
          "WorldItem": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Flags": {
        "type": "string",
        "pattern": "^(None|(NoXp|NoCash|Failed|NoDelete)(, (NoXp|NoCash|Failed|NoDelete))*)$",
        "description": "Comma list of NoXp, NoCash, Failed, NoDelete, or \u0022None\u0022."
      },
      "MissionBit": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0,
        "maximum": 639
      },
      "NextStep": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9A-Z_]{4}$"
      },
      "ExpiresAfterHours": {
        "type": [
          "integer",
          "null"
        ]
      },
      "Reward": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "Hash": {
            "type": "string"
          },
          "Credits": {
            "type": "integer"
          },
          "Xp": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "StartItems": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "$ref": "#/items/properties/Reward/properties/Records/items/items"
        }
      },
      "Waypoint": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "Playfield": {
            "type": "integer"
          },
          "Target": {
            "type": [
              "string",
              "null"
            ]
          },
          "Position": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      },
      "Waypoints": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "object",
          "properties": {
            "Playfield": {
              "type": "integer"
            },
            "X": {
              "type": "number"
            },
            "Y": {
              "type": "number"
            },
            "Z": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "Dungeon": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "Floors": {
            "type": "string"
          },
          "Quality": {
            "type": [
              "integer",
              "null"
            ]
          },
          "Style": {
            "type": [
              "integer",
              "null"
            ]
          },
          "Playfield": {
            "type": "integer"
          },
          "Entrance": {
            "type": [
              "integer",
              "null"
            ]
          },
          "MobLevelPercent": {
            "type": "integer"
          },
          "ObjectiveLevelPercent": {
            "type": "integer"
          },
          "Npcs": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "AwardsTokens": {
            "type": "boolean"
          },
          "Chests": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "Enabled": {
                "type": "boolean"
              },
              "RoomDensity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4
              },
              "CountVariationFraction": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "LootTable": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "Hash": {
                      "type": "string"
                    },
                    "Repeats": {
                      "type": "integer"
                    },
                    "Chance": {
                      "type": "integer"
                    },
                    "LevelMod": {
                      "type": "integer"
                    },
                    "IgnoreLevel": {
                      "type": "boolean"
                    },
                    "QualityPercent": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "MobLoot": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/items/properties/Dungeon/properties/Chests/properties/LootTable/items"
            }
          }
        },
        "additionalProperties": false
      },
      "TemplateHash": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false
  }
}
