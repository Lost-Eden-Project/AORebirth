{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CityControllers.schema.json",
  "title": "Org city districts per playfield: costs and buildable zones (CityControllers.json, RDB 1000039).",
  "description": "Generated by Tools/GameDataSchemas from CityCatalog.ControllersFile; do not edit by hand.",
  "type": "object",
  "properties": {
    "Playfields": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "PlayfieldId": {
            "type": "integer",
            "minimum": 1
          },
          "Name": {
            "type": [
              "string",
              "null"
            ]
          },
          "TileExtentX": {
            "type": "integer"
          },
          "TileExtentZ": {
            "type": "integer"
          },
          "Controllers": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "Index": {
                  "type": "integer",
                  "minimum": 0
                },
                "DynelType": {
                  "type": "integer"
                },
                "DynelInstance": {
                  "type": "integer"
                },
                "HouseMinLevel": {
                  "type": "integer"
                },
                "HouseMaxLevel": {
                  "type": "integer"
                },
                "PurchaseCost": {
                  "type": "integer",
                  "minimum": 0
                },
                "UpkeepCost": {
                  "type": "integer",
                  "minimum": 0
                },
                "Zones": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "object",
                    "properties": {
                      "ZoneId": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "Type": {
                        "type": "integer"
                      },
                      "Mask": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-fA-F]{26}$",
                        "description": "13 bytes of hex: 100 bits, bit z * 10 \u002B x, lowest bit first."
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "The playfield ids whose districts are for sale."
    }
  },
  "additionalProperties": false
}
