{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HouseTemplates.schema.json",
  "title": "Org city house templates: type, upkeep and footprint (HouseTemplates.json, RDB 1000040).",
  "description": "Generated by Tools/GameDataSchemas from CityCatalog.TemplatesFile; do not edit by hand.",
  "type": "object",
  "properties": {
    "Templates": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "minimum": 1
          },
          "Version": {
            "type": "integer"
          },
          "Name": {
            "type": [
              "string",
              "null"
            ]
          },
          "HouseType": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "Upkeep": {
            "type": "integer",
            "minimum": 0
          },
          "InsideTemplate": {
            "type": "integer"
          },
          "FixturesAllowed": {
            "type": "integer"
          },
          "StealthFactor": {
            "type": "number"
          },
          "TilesX": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "TilesZ": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "Layout": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9a-fA-F]{2})\u002B$",
            "description": "TilesX * TilesZ bits of hex, bit z * TilesX \u002B x, lowest bit first."
          },
          "Doors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "Template": {
                  "type": "integer"
                },
                "X": {
                  "type": "number"
                },
                "Y": {
                  "type": "number"
                },
                "Z": {
                  "type": "number"
                },
                "Turn": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "Guards": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "Hash": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "Value": {
                  "type": "integer"
                },
                "X": {
                  "type": "number"
                },
                "Y": {
                  "type": "number"
                },
                "Z": {
                  "type": "number"
                },
                "Turn": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
