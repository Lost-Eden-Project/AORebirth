{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "StaticDungeonSites.schema.json",
  "title": "Static dungeon site pool: chest, mine and turret spots per room template of one ACG style (Dungeons/Sites/\u003Cstyle\u003E.json).",
  "description": "Generated by Tools/GameDataSchemas from StaticDungeonSitePoolFile; do not edit by hand.",
  "type": "object",
  "properties": {
    "SchemaVersion": {
      "type": "integer"
    },
    "Style": {
      "type": "integer"
    },
    "Rooms": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Chests": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "PerRoom": {
                "type": "number"
              },
              "Spots": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "properties": {
                    "Position": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      }
                    },
                    "Heading": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      }
                    },
                    "Seen": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "Mines": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "PerRoom": {
                "type": "number"
              },
              "Spots": {
                "$ref": "#/properties/Rooms/additionalProperties/properties/Chests/properties/Spots"
              }
            },
            "additionalProperties": false
          },
          "Turrets": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "PerRoom": {
                "type": "number"
              },
              "Spots": {
                "$ref": "#/properties/Rooms/additionalProperties/properties/Chests/properties/Spots"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
