{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CityRules.schema.json",
  "title": "Org city rules: billing, timers, who may build (CityRules.json).",
  "description": "Generated by Tools/GameDataSchemas from CityCatalog.RulesFile; do not edit by hand.",
  "type": "object",
  "properties": {
    "Enabled": {
      "type": "boolean"
    },
    "Playfields": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "description": "The playfield ids whose districts are for sale."
    },
    "BillingPeriodDays": {
      "type": "integer",
      "minimum": 1
    },
    "UpkeepWarningHours": {
      "type": "integer",
      "minimum": 0
    },
    "EmptyPlotReleaseHours": {
      "type": "integer",
      "minimum": 1
    },
    "NoHeadquartersLockoutHours": {
      "type": "integer",
      "minimum": 0
    },
    "DemolishSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "CloakToggleCooldownSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "StartingControllerCharge": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "AdvantageChargeThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "AdvantageQuality": {
      "type": "integer",
      "minimum": 1
    },
    "ManageMinRanksAboveLowest": {
      "type": "integer",
      "minimum": 0
    },
    "MaxHousesPerPlot": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "InteractionRange": {
      "type": "number"
    },
    "PendingTimeoutMinutes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
