{
  // Named chest blocks over Defaults.json. A dungeon gets chests only with Enabled true, a RoomDensity above 0 and a
  // LootTable with rows (NPC-style loot rows: Hash, Repeats, Chance, LevelMod, optional IgnoreLevel and
  // QualityPercent).
  "none": {
    "Enabled": false
  },
  "mothership": {
    "Enabled": true,
    // 15% fewer than 2.0 (team request 32).
    "RoomDensity": 1.7,
    "LootTable": [
      { "Hash": "LEALRARE", "Repeats": 3, "Chance": 1, "LevelMod": 0, "IgnoreLevel": true },
      { "Hash": "LEALTS", "Repeats": 3, "Chance": 24, "LevelMod": 0, "IgnoreLevel": true },
      { "Hash": "LEALEQ", "Repeats": 1, "Chance": 8, "LevelMod": 0, "IgnoreLevel": true },
