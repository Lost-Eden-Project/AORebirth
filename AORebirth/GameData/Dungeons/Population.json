    "Npcs": ["ANDR", "ROLL", "CLAW", "TENT", "SHAD", "UNBR"],
    "MaxGroup": 2,
    "Aggressiveness": 60,
    "Clan": 900000,
    "AssistanceRadius": 20,
    "Features": ["AggroesAllSides"]
  },
  "mothership": {
    "Npcs": ["ARZWEH"]
  },
