{
  // Named populations over Defaults.json: which NPC templates (by hash) fill the rooms and how. Mix/Styles/Kinds
  // draw from Dungeons/Families.json instead of Npcs when that file exists. Aggressiveness (BreedHostility) and Clan
  // replace every monster's own (and a kill objective's): one clan makes them answer each other's calls for help
  // (Gameplay.json socialAggro.sameClanOnly), carried AssistanceRadius meters before socialAggro's caps and scale.
  // Features (MonsterCombatRules.json names; only AggroesAllSides) go on every monster: AggroesAllSides makes a
  // Clan, Omni or Neutral humanoid attack players of every side.
  "rubika": {
    "Npcs": ["ANDR", "ROLL", "CLAW", "TENT", "SHAD", "UNBR"],
    "MaxGroup": 2,
    "Aggressiveness": 60,
    "Clan": 900000,
    "AssistanceRadius": 20,
    "Features": ["AggroesAllSides"],
    // Team request 14: the monster count follows the mission quality. RoomChancePercent: the share of rooms that get
    // monsters at all (live captures: 60-90%); SpawnScalePercent: percent of the slider's SpawnChancePercent each spawn
    // point rolls at, so Head On / Stealth still moves it. Low levels also get a shorter call for help and wider spacing,
    // so groups in a small layout's neighbouring rooms do not pull each other in.
    "Bands": [
      { "Quality": [1, 24], "RoomChancePercent": 65, "SpawnScalePercent": 60, "AssistanceRadius": 12, "GroupRadius": 12.0 },
      { "Quality": [25, 74], "RoomChancePercent": 70, "SpawnScalePercent": 75, "AssistanceRadius": 15, "GroupRadius": 10.0 },
      { "Quality": [75, 149], "RoomChancePercent": 75, "SpawnScalePercent": 85 },
      { "Quality": [150, 250], "RoomChancePercent": 80, "SpawnScalePercent": 90 }
    ]
  },
  "mothership": {
    "Npcs": ["ARZWEH"],
    // Team request 32: at most 3 aliens within 16 m of each other, and at most 2 in a room a lift stands in (either
    // end), so a player arriving by lift is not met by several aliens at once.
    "MaxGroup": 3,
    "GroupRadius": 16.0,
    "LiftRoomMaxNpcs": 2
  },
  // Shadowlands static dungeons (Dungeons/Static, team request 2): the captured monsters are placed, so Npcs,
  // SpawnChancePercent and the level spread are not used here. The captures show them attacking on sight (aggro at
  // 4-5 m with no provocation) and pulling in ones; one clan per dungeon so they answer each other's calls for help.
  "nascence": {
    "Aggressiveness": 60,
    "Clan": 900362,
    "AssistanceRadius": 15
  },
  "elysium": {
    "Aggressiveness": 60,
    "Clan": 900362,
    "AssistanceRadius": 15
  },
  "scheol": {
    "Aggressiveness": 60,
    "Clan": 900362,
    "AssistanceRadius": 15
  },
  "adonis": {
    "Aggressiveness": 60,
    "Clan": 900362,
    "AssistanceRadius": 15
  },
  "penumbra": {
    "Aggressiveness": 60,
    "Clan": 900362,
    "AssistanceRadius": 15
  }
}
