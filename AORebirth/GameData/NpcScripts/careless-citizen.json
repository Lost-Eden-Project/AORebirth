{
  "$schema": "../../Schemas/NpcScripts.schema.json",
  "Id": "careless-citizen",
  "Params": {
    "Waypoints": "Vector3[]",
    "Litter": "ItemHash",
    "Emote": "SocialAction"
  },
  "Handlers": [
    {
      "On": "Spawned",
      "Do": [
        { "Label": "loop" },
        { "WalkTo": "$Waypoints[next]" },
        { "Wait": [1000, 2500] },
        { "Emote": "$Emote" },
        { "Wait": 1500 },
        { "SpawnWorldItem": { "Item": "$Litter", "Offset": [0.5, 0, 0.5], "LifetimeSeconds": 120 } },
        { "Goto": "loop" }
      ]
    },
    {
      "On": "HealthBelow", "Percent": 50, "Once": true, "Interrupts": true,
      "Do": [ { "Say": "Help! Somebody help!" } ]
    }
  ],
  "Bindings": []
}
